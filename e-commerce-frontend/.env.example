# Copy to `.env` and fill in. Vite only exposes variables prefixed VITE_.
# src/Config.ts prefers window.RUNTIME_CONFIG (injected at deploy time) over
# these build-time values, so one bundle can be promoted between
# environments without rebuilding.

# Base URL of the Django API, including the /api prefix.
VITE_API_BASE_URL=http://localhost:8000/api

# --- Firebase (accounts) ---
# From the Firebase console: Project settings -> General -> Your apps ->
# the web app -> "SDK setup and configuration" -> Config.
#
# These are PUBLIC values. They ship inside the JavaScript bundle and
# anyone can read them; that is how Firebase web apps are designed. What
# protects your data is Firebase's auth rules plus the API's own permission
# checks - not hiding these. The backend's service-account private key is
# the real secret and must never appear in this file.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Visual search (POST /api/search/visual). The endpoint is not deployed
# yet, so leave this off - /visual-search then shows a "coming soon"
# notice. Set to true once the backend endpoint is live.
VITE_ENABLE_VISUAL_SEARCH=false

# Optional websocket endpoint, declared in Config.ts.
VITE_APP_WEBSOCKET_URL=
